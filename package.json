{
  "name": "streamverse",
  "version": "1.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "prepare:sidecars": "node scripts/prepare-sidecars.mjs",
    "build:helper": "python scripts/build-helper.py",
    "test": "node --test scripts/tests/*.test.mjs",
    "test:helper": "python -m unittest discover -s scripts/tests -p \"test_*.py\"",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "tauri:dev": "npm run prepare:sidecars && tauri dev",
    "tauri:build": "npm run prepare:sidecars && tauri build"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tauri-apps/cli": "^2.2.5",
    "ffmpeg-static": "^5.3.0",
    "svelte": "^5.56.10",
    "svelte-check": "^4.7.6",
    "typescript": "^5.7.3",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "@lucide/svelte": "^1.33.0",
    "@tanstack/svelte-virtual": "^3.13.36",
    "@tauri-apps/api": "^2.2.0",
    "@tauri-apps/plugin-notification": "^2",
    "simple-icons": "^16.28.0"
  },
  "allowScripts": {
    "ffmpeg-static": true
  }
}
